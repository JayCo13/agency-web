# Supabase (shared project) — used by the blog.
# Copy this file to `.env.local` and fill in real values from:
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — ONLY for the local blog admin (/admin/blog).
# It bypasses Row Level Security, so it must stay in .env.local on your machine.
# NEVER add this to Netlify or commit it. The admin is disabled in production.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
